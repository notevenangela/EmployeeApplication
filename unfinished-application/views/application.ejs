<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>UnFinished Business – Employment Application</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>
  <header class="site-header">
    <h1>UnFinished Business Employment Application</h1>
  </header>

  <main>
    <div id="global-messages" aria-live="polite" class="sr-only"></div>
    <% if (success) { %>
    <div id="success-data" style="display: none;" 
         data-message="<%= success.message %>" 
         data-position="<%= success.position %>"></div>
    <% } %>

    <section class="form-container">
      <form id="applicationForm" action="/submit" method="post" novalidate>
        <div class="progress">
          <button type="button" class="progress-step active" data-step="0">1. Applicant Info</button>
          <button type="button" class="progress-step" data-step="1">2. Availability</button>
          <button type="button" class="progress-step" data-step="2">3. Education & Work</button>
          <button type="button" class="progress-step" data-step="3">4. References</button>
          <button type="button" class="progress-step" data-step="4">5. Acknowledgment</button>
        </div>

        <!-- STEP 1: Applicant Information & Medical -->
        <fieldset class="form-step active" data-step="0">
          <legend>Applicant Information</legend>

          <div class="field-group">
            <label for="applicationDate">
              Application Date <span class="required">*</span>
            </label>
            <input
              id="applicationDate"
              name="applicationDate"
              type="date"
              max="<%= todayISO %>"
              value="<%= data.applicationDate || todayISO %>"
              required
            />
            <% if (errors.applicationDate) { %>
              <p class="error"><%= errors.applicationDate %></p>
            <% } %>
          </div>

          <div class="field-group">
            <label for="firstName">
              First Name <span class="required">*</span>
            </label>
            <input
              id="firstName"
              name="firstName"
              type="text"
              maxlength="64"
              required
              value="<%= data.firstName || '' %>"
            />
            <% if (errors.firstName) { %>
              <p class="error"><%= errors.firstName %></p>
            <% } %>
          </div>

          <div class="field-group">
            <label for="middleName">Middle Name</label>
            <input
              id="middleName"
              name="middleName"
              type="text"
              maxlength="64"
              value="<%= data.middleName || '' %>"
            />
            <% if (errors.middleName) { %>
              <p class="error"><%= errors.middleName %></p>
            <% } %>
          </div>

          <div class="field-group">
            <label for="lastName">
              Last Name <span class="required">*</span>
            </label>
            <input
              id="lastName"
              name="lastName"
              type="text"
              maxlength="64"
              required
              value="<%= data.lastName || '' %>"
            />
            <% if (errors.lastName) { %>
              <p class="error"><%= errors.lastName %></p>
            <% } %>
          </div>

          <div class="field-group">
            <label for="address">Street Address</label>
            <input
              id="address"
              name="address"
              type="text"
              maxlength="100"
              value="<%= data.address || '' %>"
            />
            <% if (errors.address) { %>
              <p class="error"><%= errors.address %></p>
            <% } %>
          </div>

          <div class="field-group two-column">
            <div>
              <label for="city">City</label>
              <input
                id="city"
                name="city"
                type="text"
                maxlength="50"
                value="<%= data.city || '' %>"
              />
              <% if (errors.city) { %>
                <p class="error"><%= errors.city %></p>
              <% } %>
            </div>
            <div>
              <label for="state">State</label>
              <select id="state" name="state">
                <option value="">Select State</option>
                <option value="AL" <%= data.state === "AL" ? "selected" : "" %>>Alabama</option>
                <option value="AK" <%= data.state === "AK" ? "selected" : "" %>>Alaska</option>
                <option value="AZ" <%= data.state === "AZ" ? "selected" : "" %>>Arizona</option>
                <option value="AR" <%= data.state === "AR" ? "selected" : "" %>>Arkansas</option>
                <option value="CA" <%= data.state === "CA" ? "selected" : "" %>>California</option>
                <option value="CO" <%= data.state === "CO" ? "selected" : "" %>>Colorado</option>
                <option value="CT" <%= data.state === "CT" ? "selected" : "" %>>Connecticut</option>
                <option value="DE" <%= data.state === "DE" ? "selected" : "" %>>Delaware</option>
                <option value="FL" <%= data.state === "FL" ? "selected" : "" %>>Florida</option>
                <option value="GA" <%= data.state === "GA" ? "selected" : "" %>>Georgia</option>
                <option value="HI" <%= data.state === "HI" ? "selected" : "" %>>Hawaii</option>
                <option value="ID" <%= data.state === "ID" ? "selected" : "" %>>Idaho</option>
                <option value="IL" <%= data.state === "IL" ? "selected" : "" %>>Illinois</option>
                <option value="IN" <%= data.state === "IN" ? "selected" : "" %>>Indiana</option>
                <option value="IA" <%= data.state === "IA" ? "selected" : "" %>>Iowa</option>
                <option value="KS" <%= data.state === "KS" ? "selected" : "" %>>Kansas</option>
                <option value="KY" <%= data.state === "KY" ? "selected" : "" %>>Kentucky</option>
                <option value="LA" <%= data.state === "LA" ? "selected" : "" %>>Louisiana</option>
                <option value="ME" <%= data.state === "ME" ? "selected" : "" %>>Maine</option>
                <option value="MD" <%= data.state === "MD" ? "selected" : "" %>>Maryland</option>
                <option value="MA" <%= data.state === "MA" ? "selected" : "" %>>Massachusetts</option>
                <option value="MI" <%= data.state === "MI" ? "selected" : "" %>>Michigan</option>
                <option value="MN" <%= data.state === "MN" ? "selected" : "" %>>Minnesota</option>
                <option value="MS" <%= data.state === "MS" ? "selected" : "" %>>Mississippi</option>
                <option value="MO" <%= data.state === "MO" ? "selected" : "" %>>Missouri</option>
                <option value="MT" <%= data.state === "MT" ? "selected" : "" %>>Montana</option>
                <option value="NE" <%= data.state === "NE" ? "selected" : "" %>>Nebraska</option>
                <option value="NV" <%= data.state === "NV" ? "selected" : "" %>>Nevada</option>
                <option value="NH" <%= data.state === "NH" ? "selected" : "" %>>New Hampshire</option>
                <option value="NJ" <%= data.state === "NJ" ? "selected" : "" %>>New Jersey</option>
                <option value="NM" <%= data.state === "NM" ? "selected" : "" %>>New Mexico</option>
                <option value="NY" <%= data.state === "NY" ? "selected" : "" %>>New York</option>
                <option value="NC" <%= data.state === "NC" ? "selected" : "" %>>North Carolina</option>
                <option value="ND" <%= data.state === "ND" ? "selected" : "" %>>North Dakota</option>
                <option value="OH" <%= data.state === "OH" ? "selected" : "" %>>Ohio</option>
                <option value="OK" <%= data.state === "OK" ? "selected" : "" %>>Oklahoma</option>
                <option value="OR" <%= data.state === "OR" ? "selected" : "" %>>Oregon</option>
                <option value="PA" <%= data.state === "PA" ? "selected" : "" %>>Pennsylvania</option>
                <option value="RI" <%= data.state === "RI" ? "selected" : "" %>>Rhode Island</option>
                <option value="SC" <%= data.state === "SC" ? "selected" : "" %>>South Carolina</option>
                <option value="SD" <%= data.state === "SD" ? "selected" : "" %>>South Dakota</option>
                <option value="TN" <%= data.state === "TN" ? "selected" : "" %>>Tennessee</option>
                <option value="TX" <%= data.state === "TX" ? "selected" : "" %>>Texas</option>
                <option value="UT" <%= data.state === "UT" ? "selected" : "" %>>Utah</option>
                <option value="VT" <%= data.state === "VT" ? "selected" : "" %>>Vermont</option>
                <option value="VA" <%= data.state === "VA" ? "selected" : "" %>>Virginia</option>
                <option value="WA" <%= data.state === "WA" ? "selected" : "" %>>Washington</option>
                <option value="WV" <%= data.state === "WV" ? "selected" : "" %>>West Virginia</option>
                <option value="WI" <%= data.state === "WI" ? "selected" : "" %>>Wisconsin</option>
                <option value="WY" <%= data.state === "WY" ? "selected" : "" %>>Wyoming</option>
              </select>
              <% if (errors.state) { %>
                <p class="error"><%= errors.state %></p>
              <% } %>
            </div>
          </div>

          <div class="field-group">
            <label for="zipCode">ZIP Code</label>
            <input
              id="zipCode"
              name="zipCode"
              type="text"
              pattern="\d{5}(-\d{4})?"
              placeholder="12345 or 12345-6789"
              maxlength="10"
              value="<%= data.zipCode || '' %>"
            />
            <% if (errors.zipCode) { %>
              <p class="error"><%= errors.zipCode %></p>
            <% } %>
          </div>

          <div class="field-group">
            <label for="yearsAtAddress">How long have you lived at your current address? (years)</label>
            <input
              id="yearsAtAddress"
              name="yearsAtAddress"
              type="number"
              min="0"
              max="100"
              step="0.5"
              placeholder="2.5"
              value="<%= data.yearsAtAddress || '' %>"
            />
            <% if (errors.yearsAtAddress) { %>
              <p class="error"><%= errors.yearsAtAddress %></p>
            <% } %>
          </div>

          <div class="field-group two-column">
            <div>
              <label for="phone">
                Phone <span class="required">*</span>
              </label>
              <input
                id="phone"
                name="phone"
                type="text"
                placeholder="(555) 555-5555"
                maxlength="14"
                required
                value="<%= data.phone || '' %>"
              />
              <% if (errors.phone) { %>
                <p class="error"><%= errors.phone %></p>
              <% } %>
            </div>
            <div>
              <label for="email">
                Email <span class="required">*</span>
              </label>
              <input
                id="email"
                name="email"
                type="email"
                maxlength="64"
                required
                value="<%= data.email || '' %>"
              />
              <% if (errors.email) { %>
                <p class="error"><%= errors.email %></p>
              <% } %>
            </div>
          </div>

          <div class="field-group">
            <label class="question-label">Are you at least 18 years old? <span class="required">*</span></label>
            <div class="radio-group">
              <label>
                <input
                  type="radio"
                  name="ageVerification"
                  value="yes"
                  <%= data.ageVerification === "yes" ? "checked" : "" %>
                  required
                />
                Yes
              </label>
              <label>
                <input
                  type="radio"
                  name="ageVerification"
                  value="no"
                  <%= data.ageVerification === "no" ? "checked" : "" %>
                  required
                />
                No
              </label>
            </div>
            <% if (errors.ageVerification) { %>
              <p class="error"><%= errors.ageVerification %></p>
            <% } %>
          </div>

          <div class="field-group">
            <label for="desiredSalary">Desired Salary (per hour)</label>
            <input
              id="desiredSalary"
              name="desiredSalary"
              type="number"
              min="7.25"
              max="100"
              step="0.25"
              placeholder="15.00"
              value="<%= data.desiredSalary || '' %>"
            />
            <% if (errors.desiredSalary) { %>
              <p class="error"><%= errors.desiredSalary %></p>
            <% } %>
          </div>

          <div class="field-group">
            <label for="positionApplied">
              Position Applied For <span class="required">*</span>
            </label>
            <select id="positionApplied" name="positionApplied" required>
              <option value="">Select a position</option>
              <option value="barista" <%= data.positionApplied === "barista" ? "selected" : "" %>>Barista</option>
              <option value="cashier" <%= data.positionApplied === "cashier" ? "selected" : "" %>>Cashier</option>
              <option value="manager" <%= data.positionApplied === "manager" ? "selected" : "" %>>Manager</option>
              <option value="intern" <%= data.positionApplied === "intern" ? "selected" : "" %>>Intern</option>
            </select>
            <% if (errors.positionApplied) { %>
              <p class="error"><%= errors.positionApplied %></p>
            <% } %>
          </div>

          <fieldset class="sub-section">
            <legend>Employment Eligibility</legend>
            <label class="question-label">Are you legally authorized to work in the United States? <span class="required">*</span></label>
            <div class="radio-group">
              <label>
                <input
                  type="radio"
                  name="workAuthorized"
                  value="yes"
                  <%= data.workAuthorized === "yes" ? "checked" : "" %>
                  required
                />
                Yes
              </label>
              <label>
                <input
                  type="radio"
                  name="workAuthorized"
                  value="no"
                  <%= data.workAuthorized === "no" ? "checked" : "" %>
                  required
                />
                No
              </label>
            </div>
            <% if (errors.workAuthorized) { %>
              <p class="error"><%= errors.workAuthorized %></p>
            <% } %>

            <label class="question-label">Will you now or in the future require sponsorship for employment visa status (e.g., H-1B visa status)? <span class="required">*</span></label>
            <div class="radio-group">
              <label>
                <input
                  type="radio"
                  name="requiresSponsorship"
                  value="yes"
                  <%= data.requiresSponsorship === "yes" ? "checked" : "" %>
                  required
                />
                Yes
              </label>
              <label>
                <input
                  type="radio"
                  name="requiresSponsorship"
                  value="no"
                  <%= data.requiresSponsorship === "no" ? "checked" : "" %>
                  required
                />
                No
              </label>
            </div>
            <% if (errors.requiresSponsorship) { %>
              <p class="error"><%= errors.requiresSponsorship %></p>
            <% } %>
          </fieldset>

          <fieldset class="sub-section">
            <legend>Previous Employment</legend>
            <label class="question-label">Have you previously worked for or volunteered with UnFinished Business? <span class="required">*</span></label>
            <div class="radio-group">
              <label>
                <input
                  type="radio"
                  name="previousEmployee"
                  value="yes"
                  <%= data.previousEmployee === "yes" ? "checked" : "" %>
                  required
                />
                Yes
              </label>
              <label>
                <input
                  type="radio"
                  name="previousEmployee"
                  value="no"
                  <%= data.previousEmployee === "no" ? "checked" : "" %>
                  required
                />
                No
              </label>
            </div>
            <% if (errors.previousEmployee) { %>
              <p class="error"><%= errors.previousEmployee %></p>
            <% } %>
          </fieldset>

          <fieldset class="sub-section">
            <legend>Ability to Perform Job</legend>
            <p class="hint">
              In a real deployment, this should be phrased in an ADA-safe way (can you perform essential job functions with/without accommodation).
            </p>
            <div class="checkbox-group">
              <label>
                <input
                  type="checkbox"
                  name="medicalCanPerform"
                  value="yes"
                  <%= data.medicalCanPerform === "yes" ? "checked" : "" %>
                />
                I can perform the essential functions of this job with or without reasonable accommodation.
              </label>
              <label>
                <input
                  type="checkbox"
                  name="medicalNeedsAccommodation"
                  value="yes"
                  <%= data.medicalNeedsAccommodation === "yes" ? "checked" : "" %>
                />
                I may need reasonable accommodations.
              </label>
            </div>
          </fieldset>

          <fieldset class="sub-section">
            <legend>Disability Status</legend>
            <label class="question-label">Do you have a disability? <span class="optional">(Optional)</span></label>
            <p class="hint">We are a federal contractor or subcontractor. The law requires us to provide equal employment opportunity to qualified people with disabilities. We have a goal of having at least 7% of our workers as people with disabilities. The law says we must measure our progress towards this goal. To do this, we must ask applicants and employees if they have a disability or have ever had one. This information is voluntary and will not be used against you.</p>
            <div class="radio-group">
              <label>
                <input
                  type="radio"
                  name="disabilityStatus"
                  value="yes"
                  <%= data.disabilityStatus === "yes" ? "checked" : "" %>
                />
                Yes, I have a disability (or have a history/record of having a disability)
              </label>
              <label>
                <input
                  type="radio"
                  name="disabilityStatus"
                  value="no"
                  <%= data.disabilityStatus === "no" ? "checked" : "" %>
                />
                No, I don't have a disability
              </label>
              <label>
                <input
                  type="radio"
                  name="disabilityStatus"
                  value="prefer-not-to-answer"
                  <%= data.disabilityStatus === "prefer-not-to-answer" ? "checked" : "" %>
                />
                I don't want to answer
              </label>
            </div>
            <% if (errors.disabilityStatus) { %>
              <p class="error"><%= errors.disabilityStatus %></p>
            <% } %>
          </fieldset>

          <fieldset class="sub-section">
            <legend>Veteran Status</legend>
            <label class="question-label">Are you a veteran? <span class="optional">(Optional)</span></label>
            <div class="radio-group">
              <label>
                <input
                  type="radio"
                  name="veteranStatus"
                  value="yes"
                  <%= data.veteranStatus === "yes" ? "checked" : "" %>
                />
                Yes
              </label>
              <label>
                <input
                  type="radio"
                  name="veteranStatus"
                  value="no"
                  <%= data.veteranStatus === "no" ? "checked" : "" %>
                />
                No
              </label>
              <label>
                <input
                  type="radio"
                  name="veteranStatus"
                  value="prefer-not-to-answer"
                  <%= data.veteranStatus === "prefer-not-to-answer" ? "checked" : "" %>
                />
                I don't want to answer
              </label>
            </div>
            <% if (errors.veteranStatus) { %>
              <p class="error"><%= errors.veteranStatus %></p>
            <% } %>
          </fieldset>

          <div class="step-controls">
            <button type="button" class="btn next-step">Next</button>
          </div>
        </fieldset>

        <!-- STEP 2: Availability -->
        <fieldset class="form-step" data-step="1">
          <legend>Availability</legend>

          <div class="field-group">
            <p>Days Available to Work <span class="required">*</span></p>
          <% var days = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]; %>
            <div class="checkbox-group" id="availableDaysGroup">
              <% days.forEach(function(day) { %>
                <label>
                  <input
                    type="checkbox"
                    name="availableDays"
                    value="<%= day %>"
                    <%= (Array.isArray(data.availableDays) && data.availableDays.includes(day)) ||
                        data.availableDays === day
                        ? "checked"
                        : "" %>
                  />
                  <%= day %>
                </label>
              <% }); %>
            </div>
            <button type="button" id="selectAllDays" class="link-button">All Days</button>
            <% if (errors.availableDays) { %>
              <p class="error"><%= errors.availableDays %></p>
            <% } %>
          </div>

          <div class="field-group">
            <label for="employmentType">
              Employment Desired <span class="required">*</span>
            </label>
            <select id="employmentType" name="employmentType" required>
              <option value="">Select one</option>
              <option value="full-time" <%= data.employmentType === "full-time" ? "selected" : "" %>>Full-time</option>
              <option value="part-time" <%= data.employmentType === "part-time" ? "selected" : "" %>>Part-time</option>
              <option value="seasonal" <%= data.employmentType === "seasonal" ? "selected" : "" %>>Seasonal</option>
              <option value="intern" <%= data.employmentType === "intern" ? "selected" : "" %>>Intern</option>
            </select>
            <% if (errors.employmentType) { %>
              <p class="error"><%= errors.employmentType %></p>
            <% } %>
          </div>

          <div class="field-group">
            <label for="startDate">
              Date Available to Start <span class="required">*</span>
            </label>
            <input
              id="startDate"
              name="startDate"
              type="date"
              min="<%= futureMinDate %>"
              value="<%= data.startDate || '' %>"
              required
            />
            <% if (errors.startDate) { %>
              <p class="error"><%= errors.startDate %></p>
            <% } %>
            <p class="hint">Must be a future date, not today.</p>
          </div>

          <div class="step-controls">
            <button type="button" class="btn secondary prev-step">Back</button>
            <button type="button" class="btn next-step">Next</button>
          </div>
        </fieldset>

        <!-- STEP 3: Education & Work -->
        <fieldset class="form-step" data-step="2">
          <legend>Education & Work Experience</legend>

          <!-- Education block (cloneable) -->
          <fieldset class="sub-section" id="education-section">
            <legend>Education</legend>

            <div class="education-entry">
              <div class="field-group">
                <label for="schoolName">School Name</label>
                <input
                  id="schoolName"
                  name="schoolName"
                  type="text"
                  maxlength="50"
                  value="<%= data.schoolName || '' %>"
                />
                <% if (errors.schoolName) { %>
                  <p class="error"><%= errors.schoolName %></p>
                <% } %>
              </div>

              <div class="field-group">
                <label for="schoolCity">City</label>
                <input
                  id="schoolCity"
                  name="schoolCity"
                  type="text"
                  maxlength="30"
                  value="<%= data.schoolCity || '' %>"
                />
                <% if (errors.schoolCity) { %>
                  <p class="error"><%= errors.schoolCity %></p>
                <% } %>
              </div>

              <div class="field-group">
                <label for="schoolState">State</label>
                <select id="schoolState" name="schoolState">
                  <option value="">Select State</option>
                  <option value="AL" <%= data.schoolState === "AL" ? "selected" : "" %>>Alabama</option>
                  <option value="AK" <%= data.schoolState === "AK" ? "selected" : "" %>>Alaska</option>
                  <option value="AZ" <%= data.schoolState === "AZ" ? "selected" : "" %>>Arizona</option>
                  <option value="AR" <%= data.schoolState === "AR" ? "selected" : "" %>>Arkansas</option>
                  <option value="CA" <%= data.schoolState === "CA" ? "selected" : "" %>>California</option>
                  <option value="CO" <%= data.schoolState === "CO" ? "selected" : "" %>>Colorado</option>
                  <option value="CT" <%= data.schoolState === "CT" ? "selected" : "" %>>Connecticut</option>
                  <option value="DE" <%= data.schoolState === "DE" ? "selected" : "" %>>Delaware</option>
                  <option value="FL" <%= data.schoolState === "FL" ? "selected" : "" %>>Florida</option>
                  <option value="GA" <%= data.schoolState === "GA" ? "selected" : "" %>>Georgia</option>
                  <option value="HI" <%= data.schoolState === "HI" ? "selected" : "" %>>Hawaii</option>
                  <option value="ID" <%= data.schoolState === "ID" ? "selected" : "" %>>Idaho</option>
                  <option value="IL" <%= data.schoolState === "IL" ? "selected" : "" %>>Illinois</option>
                  <option value="IN" <%= data.schoolState === "IN" ? "selected" : "" %>>Indiana</option>
                  <option value="IA" <%= data.schoolState === "IA" ? "selected" : "" %>>Iowa</option>
                  <option value="KS" <%= data.schoolState === "KS" ? "selected" : "" %>>Kansas</option>
                  <option value="KY" <%= data.schoolState === "KY" ? "selected" : "" %>>Kentucky</option>
                  <option value="LA" <%= data.schoolState === "LA" ? "selected" : "" %>>Louisiana</option>
                  <option value="ME" <%= data.schoolState === "ME" ? "selected" : "" %>>Maine</option>
                  <option value="MD" <%= data.schoolState === "MD" ? "selected" : "" %>>Maryland</option>
                  <option value="MA" <%= data.schoolState === "MA" ? "selected" : "" %>>Massachusetts</option>
                  <option value="MI" <%= data.schoolState === "MI" ? "selected" : "" %>>Michigan</option>
                  <option value="MN" <%= data.schoolState === "MN" ? "selected" : "" %>>Minnesota</option>
                  <option value="MS" <%= data.schoolState === "MS" ? "selected" : "" %>>Mississippi</option>
                  <option value="MO" <%= data.schoolState === "MO" ? "selected" : "" %>>Missouri</option>
                  <option value="MT" <%= data.schoolState === "MT" ? "selected" : "" %>>Montana</option>
                  <option value="NE" <%= data.schoolState === "NE" ? "selected" : "" %>>Nebraska</option>
                  <option value="NV" <%= data.schoolState === "NV" ? "selected" : "" %>>Nevada</option>
                  <option value="NH" <%= data.schoolState === "NH" ? "selected" : "" %>>New Hampshire</option>
                  <option value="NJ" <%= data.schoolState === "NJ" ? "selected" : "" %>>New Jersey</option>
                  <option value="NM" <%= data.schoolState === "NM" ? "selected" : "" %>>New Mexico</option>
                  <option value="NY" <%= data.schoolState === "NY" ? "selected" : "" %>>New York</option>
                  <option value="NC" <%= data.schoolState === "NC" ? "selected" : "" %>>North Carolina</option>
                  <option value="ND" <%= data.schoolState === "ND" ? "selected" : "" %>>North Dakota</option>
                  <option value="OH" <%= data.schoolState === "OH" ? "selected" : "" %>>Ohio</option>
                  <option value="OK" <%= data.schoolState === "OK" ? "selected" : "" %>>Oklahoma</option>
                  <option value="OR" <%= data.schoolState === "OR" ? "selected" : "" %>>Oregon</option>
                  <option value="PA" <%= data.schoolState === "PA" ? "selected" : "" %>>Pennsylvania</option>
                  <option value="RI" <%= data.schoolState === "RI" ? "selected" : "" %>>Rhode Island</option>
                  <option value="SC" <%= data.schoolState === "SC" ? "selected" : "" %>>South Carolina</option>
                  <option value="SD" <%= data.schoolState === "SD" ? "selected" : "" %>>South Dakota</option>
                  <option value="TN" <%= data.schoolState === "TN" ? "selected" : "" %>>Tennessee</option>
                  <option value="TX" <%= data.schoolState === "TX" ? "selected" : "" %>>Texas</option>
                  <option value="UT" <%= data.schoolState === "UT" ? "selected" : "" %>>Utah</option>
                  <option value="VT" <%= data.schoolState === "VT" ? "selected" : "" %>>Vermont</option>
                  <option value="VA" <%= data.schoolState === "VA" ? "selected" : "" %>>Virginia</option>
                  <option value="WA" <%= data.schoolState === "WA" ? "selected" : "" %>>Washington</option>
                  <option value="WV" <%= data.schoolState === "WV" ? "selected" : "" %>>West Virginia</option>
                  <option value="WI" <%= data.schoolState === "WI" ? "selected" : "" %>>Wisconsin</option>
                  <option value="WY" <%= data.schoolState === "WY" ? "selected" : "" %>>Wyoming</option>
                  <option value="DC" <%= data.schoolState === "DC" ? "selected" : "" %>>Washington D.C.</option>
                </select>
                <% if (errors.schoolState) { %>
                  <p class="error"><%= errors.schoolState %></p>
                <% } %>
              </div>

              <div class="field-group">
                <label for="educationLevel">Level of Education</label>
                <select id="educationLevel" name="educationLevel">
                  <option value="">Select level</option>
                  <option value="hs" <%= data.educationLevel === "hs" ? "selected" : "" %>>High School Diploma / GED</option>
                  <option value="associate" <%= data.educationLevel === "associate" ? "selected" : "" %>>Associate Degree</option>
                  <option value="bachelor" <%= data.educationLevel === "bachelor" ? "selected" : "" %>>Bachelor's Degree</option>
                  <option value="master" <%= data.educationLevel === "master" ? "selected" : "" %>>Master's Degree</option>
                  <option value="other" <%= data.educationLevel === "other" ? "selected" : "" %>>Other</option>
                </select>
              </div>
            </div>

            <button type="button" id="addEducation" class="link-button">
              + Add More Education
            </button>
            <p class="hint">For the assignment, one block is enough; you can clone this for extra entries.</p>
          </fieldset>

          <!-- Work experience block (cloneable) -->
          <fieldset class="sub-section" id="work-section">
            <legend>Most Recent Work Experience</legend>

            <div class="work-entry">
              <div class="field-group">
                <label for="employerName">Employer</label>
                <input
                  id="employerName"
                  name="employerName"
                  type="text"
                  maxlength="50"
                  value="<%= data.employerName || '' %>"
                />
                <% if (errors.employerName) { %>
                  <p class="error"><%= errors.employerName %></p>
                <% } %>
              </div>

              <div class="field-group">
                <label for="workAddress">Address</label>
                <textarea
                  id="workAddress"
                  name="workAddress"
                  maxlength="100"
                  rows="2"
                ><%= data.workAddress || '' %></textarea>
                <% if (errors.workAddress) { %>
                  <p class="error"><%= errors.workAddress %></p>
                <% } %>
              </div>

              <div class="field-group two-column">
                <div>
                  <label for="jobTitle">Job Title</label>
                  <input
                    id="jobTitle"
                    name="jobTitle"
                    type="text"
                    maxlength="50"
                    value="<%= data.jobTitle || '' %>"
                  />
                  <% if (errors.jobTitle) { %>
                    <p class="error"><%= errors.jobTitle %></p>
                  <% } %>
                </div>
                <div>
                  <label for="workSupervisor">Supervisor</label>
                  <input
                    id="workSupervisor"
                    name="workSupervisor"
                    type="text"
                    maxlength="50"
                    value="<%= data.workSupervisor || '' %>"
                  />
                </div>
              </div>

              <div class="field-group two-column">
                <div>
                  <label for="workStartDate">Start Date</label>
                  <input
                    id="workStartDate"
                    name="workStartDate"
                    type="date"
                    min="1955-01-01"
                    max="<%= todayISO %>"
                    value="<%= data.workStartDate || '' %>"
                  />
                  <% if (errors.workStartDate) { %>
                    <p class="error"><%= errors.workStartDate %></p>
                  <% } %>
                </div>
                <div class="end-date-container">
                  <label for="workEndDate">End Date</label>
                  <div class="date-input-group">
                    <input
                      id="workEndDate"
                      name="workEndDate"
                      type="date"
                      min="1955-01-01"
                      max="<%= todayISO %>"
                      value="<%= data.workEndDate || '' %>"
                    />
                    <button type="button" class="still-working-btn" data-target="workEndDate">
                      Currently still working here
                    </button>
                  </div>
                  <% if (errors.workEndDate) { %>
                    <p class="error"><%= errors.workEndDate %></p>
                  <% } %>
                </div>
              </div>

              <div class="field-group">
                <label for="jobDuties">Job Duties (max 300 chars)</label>
                <textarea
                  id="jobDuties"
                  name="jobDuties"
                  maxlength="300"
                  rows="4"
                ><%= data.jobDuties || '' %></textarea>
                <% if (errors.jobDuties) { %>
                  <p class="error"><%= errors.jobDuties %></p>
                <% } %>
              </div>
            </div>

            <button type="button" id="addWorkExperience" class="link-button">
              + Add More Work Experience
            </button>
          </fieldset>

          <fieldset class="sub-section">
            <legend>Additional Skills & Experience</legend>
            <div class="field-group">
              <label for="skills">Skills and Experience (max 200 chars)</label>
              <textarea
                id="skills"
                name="skills"
                maxlength="200"
                rows="3"
              ><%= data.skills || '' %></textarea>
              <% if (errors.skills) { %>
                <p class="error"><%= errors.skills %></p>
              <% } %>
            </div>
          </fieldset>

          <div class="step-controls">
            <button type="button" class="btn secondary prev-step">Back</button>
            <button type="button" class="btn next-step">Next</button>
          </div>
        </fieldset>

        <!-- STEP 4: References -->
        <fieldset class="form-step" data-step="3">
          <legend>References</legend>

          <fieldset class="sub-section" id="references-section">
            <legend>Reference</legend>

            <div class="reference-entry">
              <div class="field-group">
                <label for="refName">Reference Name</label>
                <input
                  id="refName"
                  name="refName"
                  type="text"
                  maxlength="50"
                  value="<%= data.refName || '' %>"
                />
                <% if (errors.refName) { %>
                  <p class="error"><%= errors.refName %></p>
                <% } %>
              </div>

              <div class="field-group">
                <label for="refTitle">Title</label>
                <input
                  id="refTitle"
                  name="refTitle"
                  type="text"
                  maxlength="50"
                  value="<%= data.refTitle || '' %>"
                />
              </div>

              <div class="field-group">
                <label for="refCompany">Company</label>
                <input
                  id="refCompany"
                  name="refCompany"
                  type="text"
                  maxlength="50"
                  value="<%= data.refCompany || '' %>"
                />
                <% if (errors.refCompany) { %>
                  <p class="error"><%= errors.refCompany %></p>
                <% } %>
              </div>

              <div class="field-group">
                <label for="refPhone">Phone</label>
                <input
                  id="refPhone"
                  name="refPhone"
                  type="text"
                  placeholder="(555) 555-5555"
                  maxlength="14"
                  value="<%= data.refPhone || '' %>"
                />
                <% if (errors.refPhone) { %>
                  <p class="error"><%= errors.refPhone %></p>
                <% } %>
              </div>

              <div class="field-group">
                <label for="refEmail">Email</label>
                <input
                  id="refEmail"
                  name="refEmail"
                  type="email"
                  maxlength="64"
                  value="<%= data.refEmail || '' %>"
                />
                <% if (errors.refEmail) { %>
                  <p class="error"><%= errors.refEmail %></p>
                <% } %>
              </div>
            </div>

            <button type="button" id="addReference" class="link-button">
              + Add More References
            </button>
          </fieldset>

          <div class="step-controls">
            <button type="button" class="btn secondary prev-step">Back</button>
            <button type="button" class="btn next-step">Next</button>
          </div>
        </fieldset>

        <!-- STEP 5: Acknowledgment -->
        <fieldset class="form-step" data-step="4">
          <legend>Application Acknowledgment</legend>

          <div class="acknowledgment-block">
            <p><strong>PLEASE READ AND SIGN</strong></p>
            <p><strong>JOB PAPER</strong></p>
            <p>IF I WANT UNFINISHED BUSINESS TO LOOK AT MY JOB PAPER, I AGREE TO THIS STUFF:</p>
            <ul>
              <li>GETTING THE JOB DOESN’T MEAN I GET TO KEEP IT FOREVER. EVEN IF THEY GIVE ME A BOOK WITH RULES, THAT DOESN’T MEAN I’M REALLY HIRED.</li>
              <li>I CAN QUIT ANYTIME I WANT, AND THE COMPANY CAN ALSO FIRE ME ANYTIME. THE ONLY WAY THIS CHANGES IS IF THE BOSS WRITES AND SIGNS A PAPER. THE COMPANY CAN ALSO CHANGE RULES AND BENEFITS AFTER I START WORKING.</li>
              <li>I SAY IT’S OKAY FOR UNFINISHED TO CHECK THE THINGS I WROTE ON THIS PAPER. IF I LIED OR LEFT OUT SOMETHING BIG, THEY CAN FIRE ME. THEY CAN ALSO CALL THE PEOPLE I LISTED. IF ANYTHING BAD HAPPENS BECAUSE THEY CALLED THEM, IT’S NOT THE COMPANY’S FAULT.</li>
              <li>THE COMPANY HAS RULES ABOUT NO DRUGS OR ALCOHOL. I MAY HAVE TO TAKE A TEST BEFORE WORKING AND MIGHT HAVE TO DO A HEALTH CHECK TO MAKE SURE I CAN DO THE JOB.</li>
              <li>UNFINISHED BUSINESS CAN DO A BACKGROUND CHECK ON ME. IF I WANT TO KNOW WHY, I CAN ASK IN WRITING AND THEY HAVE TO TELL ME.</li>
              <li>THE FIRST 60 DAYS ARE A “TRY-OUT” TO SEE IF I FIT IN. I CAN STILL QUIT OR GET FIRED DURING THIS TIME.</li>
            </ul>
            <p>UNFINISHED BUSINESS GIVES EVERYONE A FAIR CHANCE. THANKS FOR SIGNING!</p>
          </div>

          <div class="field-group">
            <label>
              <input
                type="checkbox"
                name="acknowledge"
                value="yes"
                <%= data.acknowledge === "yes" ? "checked" : "" %>
              />
              I have read and agree to the above.
            </label>
            <% if (errors.acknowledge) { %>
              <p class="error"><%= errors.acknowledge %></p>
            <% } %>
          </div>

          <div class="field-group two-column">
            <div>
              <label for="signature">Sign Your Name <span class="required">*</span></label>
              <input
                id="signature"
                name="signature"
                type="text"
                value="<%= data.signature || '' %>"
                required
              />
              <% if (errors.signature) { %>
                <p class="error"><%= errors.signature %></p>
              <% } %>
            </div>
            <div>
              <label for="signatureDate">Date <span class="required">*</span></label>
              <input
                id="signatureDate"
                name="signatureDate"
                type="date"
                max="<%= todayISO %>"
                value="<%= data.signatureDate || '' %>"
                required
              />
              <% if (errors.signatureDate) { %>
                <p class="error"><%= errors.signatureDate %></p>
              <% } %>
            </div>
          </div>

          <div class="step-controls">
            <button type="button" class="btn secondary prev-step">Back</button>
            <button type="submit" class="btn primary">Submit Application</button>
          </div>
        </fieldset>
      </form>
    </section>
  </main>

  <script>
    window.APP_CONFIG = {
      todayISO: "<%= todayISO %>",
      futureMinDate: "<%= futureMinDate %>"
    };
  </script>
  <script src="/js/form.js"></script>
</body>
</html>
